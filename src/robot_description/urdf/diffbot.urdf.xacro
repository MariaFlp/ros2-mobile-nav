<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diffbot">

  <!-- ===== Parameters (edit here, not in the links) ===== -->
  <xacro:property name="base_length"   value="0.40"/>
  <xacro:property name="base_width"    value="0.25"/>
  <xacro:property name="base_height"   value="0.10"/>
  <xacro:property name="base_mass"     value="5.0"/>

  <xacro:property name="wheel_radius"  value="0.05"/>
  <xacro:property name="wheel_width"   value="0.03"/>
  <xacro:property name="wheel_mass"    value="0.5"/>
  <xacro:property name="wheel_sep"     value="0.30"/>  <!-- distance between wheel centres -->
  <xacro:property name="wheel_x"       value="0.0"/>

  <!-- Chassis bottom sits ground_clear above the floor (base_link is at wheel-axle height) -->
  <xacro:property name="ground_clear"  value="0.03"/>
  <xacro:property name="base_z"        value="${ground_clear - wheel_radius + base_height/2}"/>

  <xacro:property name="caster_radius" value="0.02"/>
  <xacro:property name="caster_x"      value="0.15"/>

  <!-- ===== Inertia macros ===== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m/12*(y*y+z*z)}" ixy="0" ixz="0"
               iyy="${m/12*(x*x+z*z)}" iyz="0"
               izz="${m/12*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- Wheel: cylinder axis along local Y -->
  <xacro:macro name="wheel_inertia" params="m r w">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+w*w)/12}" ixy="0" ixz="0"
               iyy="${m*r*r/2}" iyz="0"
               izz="${m*(3*r*r+w*w)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2*m*r*r/5}" ixy="0" ixz="0"
               iyy="${2*m*r*r/5}" iyz="0"
               izz="${2*m*r*r/5}"/>
    </inertial>
  </xacro:macro>

  <!-- ===== Links ===== -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="body"><color rgba="0.15 0.35 0.75 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Drive wheels -->
  <xacro:macro name="wheel" params="name y_sign">
    <link name="${name}_wheel">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="tyre"><color rgba="0.05 0.05 0.05 1"/></material>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:wheel_inertia m="${wheel_mass}" r="${wheel_radius}" w="${wheel_width}"/>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${wheel_x} ${y_sign*wheel_sep/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${name}_wheel">
      <mu1>1.0</mu1><mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="left"  y_sign="1"/>
  <xacro:wheel name="right" y_sign="-1"/>

  <!-- Frictionless casters (front and rear) for stability -->
  <xacro:macro name="caster" params="name x_pos">
    <link name="${name}_caster">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="caster"><color rgba="0.6 0.6 0.6 1"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:sphere_inertia m="0.05" r="${caster_radius}"/>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster"/>
      <origin xyz="${x_pos} 0 ${-(wheel_radius - caster_radius)}"/>
    </joint>
    <gazebo reference="${name}_caster">
      <mu1>0.0</mu1><mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster name="front" x_pos="${caster_x}"/>
  <xacro:caster name="rear"  x_pos="${-caster_x}"/>

  <!-- Sensors + Gazebo plugins -->
  <xacro:include filename="sensors.xacro"/>
  <xacro:include filename="gazebo.xacro"/>

</robot>
