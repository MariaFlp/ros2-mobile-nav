<?xml version="1.0"?>
<package format="3">
  <name>robot_missions</name>
  <version>0.1.0</version>
  <description>Indoor delivery mission manager: request queue, trips, retries and delivery logging on top of Nav2</description>
  <maintainer email="82089636+MariaFlp@users.noreply.github.com">mfilip</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
